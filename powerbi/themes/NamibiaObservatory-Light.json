{
  "name": "Namibia Observatory \u2014 Light",
  "dataColors": [
    "#1F6FB2",
    "#D9772B",
    "#0E9E7E",
    "#C8453F",
    "#D9A520",
    "#6E5BC6",
    "#7E9E2F",
    "#D4568C"
  ],
  "background": "#FBFAF7",
  "backgroundLight": "#F4F2EC",
  "backgroundNeutral": "#EFEDE5",
  "foreground": "#1C2B33",
  "foregroundNeutralSecondary": "#5A6B74",
  "foregroundNeutralTertiary": "#8D9BA3",
  "tableAccent": "#1F6FB2",
  "secondaryBackground": "#EFEDE5",
  "good": "#1B7A4F",
  "neutral": "#C79A1E",
  "bad": "#A8302A",
  "minimum": "#5B3808",
  "center": "#E6E3DC",
  "maximum": "#23455F",
  "null": "#8D9BA3",
  "divergentPalette": [
    "#5B3808",
    "#7E5212",
    "#A2761F",
    "#B79450",
    "#C6AC77",
    "#E6E3DC",
    "#9CB5C6",
    "#779FB9",
    "#5A869F",
    "#3B6887",
    "#23455F"
  ],
  "sequentialPalette": [
    "#CFA862",
    "#B78B3C",
    "#9C6D22",
    "#7E5213",
    "#5B3808"
  ],
  "textClasses": {
    "callout": {
      "fontSize": 40,
      "fontFace": "Segoe UI Semibold",
      "color": "#1C2B33"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#1C2B33"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1C2B33"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#5A6B74"
    },
    "largeTitle": {
      "fontSize": 20,
      "fontFace": "Segoe UI Semibold",
      "color": "#1C2B33"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FBFAF7"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2DED3"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#1C2B33"
              }
            },
            "background": {
              "solid": {
                "color": "#FBFAF7"
              }
            },
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "show": false
          }
        ],
        "spacing": [
          {
            "customizeSpacing": true,
            "spaceBelowTitle": 6
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#5A6B74"
              }
            },
            "fontSize": 10,
            "lineColor": {
              "solid": {
                "color": "#E2DED3"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineThickness": 1,
            "gridlineStyle": "solid",
            "gridlineColor": {
              "solid": {
                "color": "#E7E3D9"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#5A6B74"
              }
            },
            "fontSize": 10
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "showTitle": false,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#5A6B74"
              }
            }
          }
        ],
        "labels": [
          {
            "show": false
          }
        ],
        "wordWrap": [
          {
            "show": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F2EC"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F2EC"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false,
            "lineStyle": "solid"
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [
          {
            "fill": {
              "solid": {
                "color": "#1F6FB2"
              }
            }
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [
          {
            "fill": {
              "solid": {
                "color": "#1F6FB2"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 34,
            "color": {
              "solid": {
                "color": "#1C2B33"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#5A6B74"
              }
            }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "smallMultiplesLayout": [
          {
            "gridLineType": "None"
          }
        ],
        "calloutValue": [
          {
            "fontSize": 34,
            "fontFamily": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#1C2B33"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#5A6B74"
              }
            },
            "fontSize": 10
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1C2B33"
              }
            },
            "background": {
              "solid": {
                "color": "#FBFAF7"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E7E3D9"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#E2DED3"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#5A6B74"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FBFAF7"
              }
            },
            "fontSize": 10,
            "bold": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1C2B33"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FBFAF7"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1C2B33"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F4F2EC"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "shape": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#FBFAF7"
              }
            }
          }
        ],
        "line": [
          {
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#E2DED3"
              }
            },
            "weight": 1,
            "roundEdge": 8
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#EFEDE5"
              }
            }
          }
        ],
        "text": [
          {
            "fontColor": {
              "solid": {
                "color": "#1C2B33"
              }
            },
            "fontSize": 10
          }
        ]
      }
    }
  }
}
