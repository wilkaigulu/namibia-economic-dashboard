// =====================================================================
// Namibia Observatory - measures.dax  (v2, matches the live model)
//
// All measures live in the table 'Measure Table'.
// To add or change one: Power BI > DAX query view, paste the measure as
//   DEFINE MEASURE 'Measure Table'[Name] = <expression>
//   EVALUATE ROW ( "ok", 1 )
// then click "Update model: Add new measure" / "Overwrite measure".
// Or paste a single expression into the formula bar of a new measure.
//
// Model assumed (data/warehouse/):
//   fact_indicator        [date, indicator, value, unit, frequency, category,
//                          source, is_forecast]
//   dim_indicator         [indicator, label, category, unit, direction, benchmark]
//   dim_date              [date, year, month, quarter, fiscal_year_label,
//                          rain_season_label, is_future]   <- marked as date table
//   dim_region            [slug, name, zone, lat, lon]
//   fact_climate_monthly  [date, region, spi_12, drought_score,
//                          climate_risk_index, ...]
//
// Relationships:
//   dim_date[date]            1 -> * fact_indicator[date]
//   dim_indicator[indicator]  1 -> * fact_indicator[indicator]
//   dim_region[slug]          1 -> * fact_climate_monthly[region]
//   dim_date[date]            1 -> * fact_climate_monthly[date]
//
// Colours below are the Light theme. Dark-theme equivalents are in comments.
// Do NOT keep v1 measures (GDP Growth Latest, Inflation Latest, ...). They
// read fact_indicator_old and should be deleted from the model.
// =====================================================================


// ---------------------------------------------------------------------
// 1. LATEST VALUE, DATE AND PREVIOUS VALUE
// ---------------------------------------------------------------------
// One measure serves every KPI: the indicator is chosen by the visual's
// filter (filter the card on dim_indicator[indicator]).
// Forecast rows are excluded, so "latest" always means latest outturn.

Latest Date =
CALCULATE (
    MAX ( fact_indicator[date] ),
    fact_indicator[is_forecast] = FALSE ()
)


Latest Value =
VAR _d = [Latest Date]
RETURN
    CALCULATE (
        SUM ( fact_indicator[value] ),
        fact_indicator[date] = _d,
        fact_indicator[is_forecast] = FALSE ()
    )


Previous Value =
VAR _d = [Latest Date]
RETURN
    CALCULATE (
        [Latest Value],
        REMOVEFILTERS ( dim_date ),
        dim_date[date] < _d
    )


// ---------------------------------------------------------------------
// 2. CHANGE, ARROW, CAPTION, COLOUR
// ---------------------------------------------------------------------

Change =
VAR _now  = [Latest Value]
VAR _prev = [Previous Value]
RETURN
    IF ( NOT ( ISBLANK ( _now ) || ISBLANK ( _prev ) ), _now - _prev )


// Arrow glyph, so direction is never carried by colour alone.
Change Arrow =
VAR _chg = [Change]
RETURN
    SWITCH ( TRUE (), ISBLANK ( _chg ), "", _chg > 0, "▲", _chg < 0, "▼", "—" )


// Unit-aware caption, e.g.  "▼ 0.9 pp vs 2025", "▲ US$374 vs 2024",
// "▲ N$6.5bn vs 2025". The comparison year is the previous actual
// observation, so sparse series (labour survey) read correctly.
Change Caption =
VAR _latest = [Latest Date]
VAR _chg    = [Change]
VAR _abs    = ABS ( _chg )
VAR _unit   = SELECTEDVALUE ( dim_indicator[unit] )
VAR _prev =
    CALCULATE (
        MAX ( fact_indicator[date] ),
        REMOVEFILTERS ( dim_date ),
        fact_indicator[is_forecast] = FALSE (),
        fact_indicator[date] < _latest
    )
VAR _freq   = SELECTEDVALUE ( dim_indicator[frequency] )
VAR _when   = IF ( _freq = "monthly", FORMAT ( _prev, "mmm yyyy" ), FORMAT ( _prev, "yyyy" ) )
VAR _txt =
    SWITCH (
        TRUE (),
        _unit IN { "percent", "percent_gdp" }, FORMAT ( _abs, "0.0" ) & " pp",
        _unit = "usd",                         "US$" & FORMAT ( _abs, "#,0" ),
        _unit = "nad_billion",                 "N$" & FORMAT ( _abs, "#,0.0" ) & "bn",
        _unit = "nad_million",                 "N$" & FORMAT ( _abs / 1000, "#,0.0" ) & "bn",
        FORMAT ( _abs, "0.0" )
    )
RETURN
    IF (
        NOT ISBLANK ( _chg ),
        [Change Arrow] & " " & _txt & " vs " & _when
    )


// Direction-aware colour: dim_indicator[direction] is up_good / up_bad /
// neutral, so one measure serves every tile.
// Dark theme: good #2E9A66, bad #D4544A, flat #9DB2BF
Change Colour =
VAR _chg = [Change]
VAR _dir = SELECTEDVALUE ( dim_indicator[direction] )
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( _chg ) || _dir = "neutral", "#5A6B74",
        _dir = "up_good" && _chg > 0,         "#1B7A4F",
        _dir = "up_good" && _chg < 0,         "#A8302A",
        _dir = "up_bad"  && _chg > 0,         "#A8302A",
        _dir = "up_bad"  && _chg < 0,         "#1B7A4F",
        "#5A6B74"
    )


// ---------------------------------------------------------------------
// 3. UNIT-AWARE VALUE TEXT (the callout on every KPI tile)
// ---------------------------------------------------------------------
// value holds percent, N$ billions, USD and persons in one column, so the
// format is chosen from dim_indicator[unit].

Latest Value Formatted =
VAR _v    = [Latest Value]
VAR _unit = SELECTEDVALUE ( dim_indicator[unit] )
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( _v ),        "—",
        _unit = "percent",     FORMAT ( _v, "0.0" ) & "%",
        _unit = "percent_gdp", FORMAT ( _v, "0.0" ) & "% of GDP",
        _unit = "nad_billion", "N$" & FORMAT ( _v, "#,0.0" ) & "bn",
        _unit = "nad_million", "N$" & FORMAT ( _v / 1000, "#,0.0" ) & "bn",
        _unit = "usd",         "US$" & FORMAT ( _v, "#,0" ),
        _unit = "persons",     FORMAT ( _v / 1000000, "0.00" ) & "m",
        _unit = "celsius",     FORMAT ( _v, "+0.0;-0.0;0.0" ) & "°C",
        _unit = "mm",          FORMAT ( _v, "#,0" ) & " mm",
        _unit = "z_score",     FORMAT ( _v, "0.00" ),
        _unit = "months",      FORMAT ( _v, "0.0" ) & " mo",
        FORMAT ( _v, "#,0.0" )
    )


// ---------------------------------------------------------------------
// 4. ACTUAL vs PROJECTION
// ---------------------------------------------------------------------
// Line charts: Value Actual (solid) + Value Forecast (dashed). Value
// Forecast starts at the last outturn so the dashed line joins the solid one.
// Column charts: Value Actual + Value Projected (stacked). Value Projected
// holds ONLY forecast rows, so columns never overlap.

Value Actual =
CALCULATE ( SUM ( fact_indicator[value] ), fact_indicator[is_forecast] = FALSE () )


Value Forecast =
VAR _lastActual =
    CALCULATE (
        MAX ( fact_indicator[date] ),
        REMOVEFILTERS ( dim_date ),
        fact_indicator[is_forecast] = FALSE ()
    )
RETURN
    CALCULATE (
        SUM ( fact_indicator[value] ),
        REMOVEFILTERS ( fact_indicator[is_forecast] ),
        KEEPFILTERS ( dim_date[date] >= _lastActual )
    )


Value Projected =
CALCULATE ( SUM ( fact_indicator[value] ), fact_indicator[is_forecast] = TRUE () )


// ---------------------------------------------------------------------
// 5. BENCHMARK
// ---------------------------------------------------------------------
// Threshold from dim_indicator (60% debt, 4.5% inflation, 3% deficit, ...).

Benchmark = SELECTEDVALUE ( dim_indicator[benchmark] )


// ---------------------------------------------------------------------
// 6. CLIMATE RISK
// ---------------------------------------------------------------------

Climate Risk = AVERAGE ( fact_climate_monthly[climate_risk_index] )


SPI 12 = AVERAGE ( fact_climate_monthly[spi_12] )


// National average at the most recent month, ignoring the year slicer.
Climate Risk Latest =
VAR _last = CALCULATE ( MAX ( fact_climate_monthly[date] ), REMOVEFILTERS ( dim_date ) )
RETURN
    CALCULATE (
        [Climate Risk],
        REMOVEFILTERS ( dim_date ),
        fact_climate_monthly[date] = _last
    )


// Regions with SPI-12 <= -1 in the latest month. BLANK means none.
// A national average can hide three regions in extreme drought, so this
// is the number to show next to the band.
Regions In Drought =
VAR _last = CALCULATE ( MAX ( fact_climate_monthly[date] ), REMOVEFILTERS ( dim_date ) )
RETURN
    CALCULATE (
        DISTINCTCOUNT ( fact_climate_monthly[region] ),
        REMOVEFILTERS ( dim_date ),
        fact_climate_monthly[date] = _last,
        fact_climate_monthly[spi_12] <= -1
    )


// Text for the "Regions in drought" tile: shows "0 of 10" instead of blank.
Regions In Drought Label =
COALESCE ( [Regions In Drought], 0 ) & " of " & COUNTROWS ( ALL ( dim_region ) )


// SPI-12 at the most recent month, ignoring the year slicer. Put
// dim_region[name] on the axis to get one bar per region (Climate & Energy page).
SPI 12 Latest =
VAR _last = CALCULATE ( MAX ( fact_climate_monthly[date] ), REMOVEFILTERS ( dim_date ) )
RETURN
    CALCULATE (
        [SPI 12],
        REMOVEFILTERS ( dim_date ),
        fact_climate_monthly[date] = _last
    )


// Ordinal band (Normal < 0.8, Watch >= 0.8, Severe >= 1.3, Extreme >= 2.0).
Risk Band =
VAR _r = [Climate Risk Latest]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( _r ), "No data",
        _r >= 2.0,      "Extreme",
        _r >= 1.3,      "Severe",
        _r >= 0.8,      "Watch",
        "Normal"
    )


// One-hue sand ramp for ordered bands (never a traffic-light scale).
// Dark theme: Extreme #E4C286, Severe #B07F31, Watch #71501A, Normal #4E8AA8
Risk Band Colour =
SWITCH (
    [Risk Band],
    "Extreme", "#5B3808",
    "Severe",  "#9C6D22",
    "Watch",   "#CFA862",
    "Normal",  "#5A869F",
    "#8D9BA3"
)


// ---------------------------------------------------------------------
// 7. HEADLINE SENTENCE (Executive Overview, under the title)
// ---------------------------------------------------------------------

Executive Headline =
VAR _debt  = CALCULATE ( [Latest Value], dim_indicator[indicator] = "DEBT_GDP" )
VAR _infl  = CALCULATE ( [Latest Value], dim_indicator[indicator] = "INFLATION" )
VAR _unemp = CALCULATE ( [Latest Value], dim_indicator[indicator] = "UNEMPLOYMENT_STRICT" )
VAR _nDry  = [Regions In Drought]
RETURN
    "Debt " & FORMAT ( _debt, "0.0" ) & "% of GDP · inflation " & FORMAT ( _infl, "0.0" )
        & "% · unemployment " & FORMAT ( _unemp, "0.0" ) & "% (2023) · climate risk "
        & LOWER ( [Risk Band] )
        & IF (
            _nDry > 0,
            " (" & _nDry & " of " & COUNTROWS ( ALL ( dim_region ) ) & " regions in drought)",
            ""
        )


// ---------------------------------------------------------------------
// 8. DATA FRESHNESS (footer of every page)
// ---------------------------------------------------------------------

Data As Of =
VAR _d =
    CALCULATE (
        MAX ( fact_indicator[date] ),
        ALL ( fact_indicator ),
        fact_indicator[is_forecast] = FALSE ()
    )
RETURN
    "Data as of " & FORMAT ( _d, "d mmm yyyy" ) & " · refreshed monthly via GitHub Actions"
